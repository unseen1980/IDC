        "auto_tune": false,
        "auto_adapt_intents": true,
        "contextual_embeddings": true,
        "density_aware": true
      },
      "segment_file": "segments.idc.l100.L20.m3.b120.c30.jsonl",
      "paper_results": {
        "idc": { "R1": 0.667, "R5": 0.933, "MRR": 0.789, "chunks": 39, "coverage": 0.933 },
        "best_baseline": { "method": "fixed", "R1": 0.400, "R5": 0.800, "MRR": 0.530 }
