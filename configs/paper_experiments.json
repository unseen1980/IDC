        "auto_adapt_intents": false,
        "contextual_embeddings": true,
        "density_aware": true
      },
      "paper_results": {
        "idc": { "R1": 0.689, "R5": 0.952, "MRR": 0.793, "chunks": 58, "coverage": 1.000 },
