      "idc_params": {
        "lambda": 0.05,
        "max_len": 20,
        "min_len": 3,
        "boundary_penalty": 1.5,
        "coherence_weight": 0.1,
        "auto_tune": false,
        "auto_adapt_intents": true,
        "contextual_embeddings": true,
        "density_aware": true
