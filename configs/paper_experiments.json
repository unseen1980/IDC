      "stats_match_stored": true,
      "notes": "Results in out/arxiv_bert_finance/stats.json match paper exactly. Auto-adapt intents scaled to ~37 intents for 495-sentence document."
    },
    "fiori": {
      "description": "Fiori: SAP Fiori Tools technical documentation bundle (15 gold spans)",
      "input_file": "data/fiori/fiori_tools_docs.txt",
