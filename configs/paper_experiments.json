      "hybrid_tune_results": {
        "idc": { "R1": 0.867, "R5": 0.867, "MRR": 0.867, "chunks": 277, "avg_len": 6.6 }
      },
      "stats_match_stored": false,
      "notes": "Hybrid-tuned params (find_best_idc_config.py) achieve R@1=0.867, significantly beating paper's 0.533. 4022 of 4158 configs meet paper target."
    },
    "qasper": {
      "description": "Qasper: 10 academic research papers (10 gold QA pairs)",
      "input_file": "data/qasper/qasper-dev-v0.3.json",
      "output_dir": "out/qasper",
      "script": "scripts/run_qasper_e2e.sh",
      "env_overrides": {
        "LIMIT": 10
