{
  "_description": "Exact configurations used to produce the results in the IEEE paper (idc_arxiv_ieee.tex). These parameters were captured from the pipeline runs, auto-tune reports, and segment filenames in the out/ directories.",
  "_paper": "IntentDrivenDynamicChunking.pdf",
  "_global": {
    "embedding_model": "gemini-embedding-001",
    "embedding_dimension": 1536,
    "intent_model": "gemini-2.5-flash",
    "hybrid_retrieval_weights": { "dense": 0.6, "bm25": 0.4 },
    "bm25_params": { "k1": 1.5, "b": 0.75 },
    "top_k": 5,
    "pseudo_span_params": {
      "threshold": 0.45,
      "neighbor_frac": 0.90,
      "max_span_len": 6
    },
    "baselines": {
      "fixed": { "target_len": 6 },
      "sliding": { "size": 6, "stride": 3 },
      "coherence": { "window": 1, "min_len": 1, "max_len": 10, "approx_chunk_len": 6 },
      "paragraphs": {}
    }
  },
  "datasets": {
    "newsqa": {
      "description": "NewsQA: 10 news stories concatenated (344 sentences, 15 gold spans)",
      "input_file": "data/input/newsqa_corpus.txt",
      "output_dir": "out/newsqa_corpus",
      "doc_name": "newsqa_corpus",
      "script": "scripts/run_idc_pipeline.sh",
      "idc_params": {
        "lambda": 0.005,
        "max_len": 30,
        "min_len": 3,
        "boundary_penalty": 1.0,
        "coherence_weight": 0.0,
        "auto_tune": false,
        "auto_adapt_intents": false,
        "contextual_embeddings": true,
        "density_aware": true
      },
      "segment_file": "segments.idc.l500.L30.m3.b100.c00.jsonl",
      "paper_results": {
        "idc": { "R1": 0.933, "R5": 1.000, "MRR": 0.956, "chunks": 25, "coverage": 1.000 },
        "best_baseline": { "method": "coherence", "R1": 0.867, "R5": 0.867, "MRR": 0.867 }
      },
      "hybrid_tune_results": {
        "idc": { "R1": 0.788, "R5": 1.000, "MRR": 0.870 }
      },
      "stats_match_stored": false,
      "notes": "Hybrid-tuned params (find_best_idc_config.py) achieve R@1=0.788 under hybrid eval (same eval as baselines). Paper R@1=0.933 was under dense-only eval."
    },
    "squad_1doc": {
      "description": "SQuAD 1-doc: Normans Wikipedia article (12 gold spans from SQuAD 2.0 dev)",
      "input_file": "data/input/Normans.txt",
      "output_dir": "out/Normans",
      "doc_name": "Normans",
      "script": "scripts/run_idc_pipeline.sh",
      "idc_params": {
        "lambda": 0.0001,
        "max_len": 12,
        "min_len": 3,
        "boundary_penalty": 1.0,
        "coherence_weight": 0.0,
        "auto_tune": false,
        "auto_tune_baselines": true,
        "auto_adapt_intents": false,
        "contextual_embeddings": true,
        "density_aware": true
      },
      "paper_results": {
        "idc": { "R1": 0.917, "R5": 1.000, "MRR": 0.958, "chunks": 25, "coverage": 1.000 },
        "best_baseline": { "method": "coherence", "R1": 0.917, "R5": 0.917, "MRR": 0.917 }
      },
      "hybrid_tune_results": {
        "idc": { "R1": 1.000, "R5": 1.000, "MRR": 1.000, "chunks": 21, "avg_len": 8.3 }
